# ═══════════════════════════════════════════════════════════════
# Axeng — Environment Variables Template
# Copy this file to .env and fill in your values.
# .env is gitignored — NEVER commit real API keys.
# ═══════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────
# LLM PROVIDER — pick one (or multiple for fallback)
# ───────────────────────────────────────────────────────────────

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-xxxx

# OpenAI (GPT-4o, o1, etc.)
OPENAI_API_KEY=sk-xxxx

# Google AI (Gemini)
GOOGLE_API_KEY=xxxx

# Groq (free tier, fast)
GROQ_API_KEY=xxxx

# OpenRouter (multi-provider)
OPENROUTER_API_KEY=sk-or-xxxx

# ───────────────────────────────────────────────────────────────
# GITHUB
# ───────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_xxxx
# Or authenticate with: gh auth login (CLI-based, no token needed)

# ───────────────────────────────────────────────────────────────
# LINEAR
# ───────────────────────────────────────────────────────────────
LINEAR_API_KEY=lin_xxxx

# ───────────────────────────────────────────────────────────────
# GOOGLE WORKSPACE (Gmail + Calendar)
# ───────────────────────────────────────────────────────────────
# OAuth credentials file (path within container or host)
GOOGLE_CLIENT_SECRET=~/.hermes/google_client_secret.json
GOOGLE_TOKEN_PATH=~/.hermes/google_token.json

# ───────────────────────────────────────────────────────────────
# NEWS API (optional — for daily briefing world news)
# ───────────────────────────────────────────────────────────────
NEWS_API_KEY=xxxx

# ───────────────────────────────────────────────────────────────
# TELEGRAM (optional — for bot notifications)
# ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=xxxx
TELEGRAM_CHAT_ID=xxxx

# ───────────────────────────────────────────────────────────────
# STREAMLIT UI (optional — web dashboard)
# ───────────────────────────────────────────────────────────────
STREAMLIT_SERVER_PORT=8501

# ───────────────────────────────────────────────────────────────
# DATA STORAGE (optional — for multi-user/SaaS mode)
# ───────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://axeng:password@localhost:5432/axeng
# REDIS_URL=redis://localhost:6379/0