#!/usr/bin/env bash
# ══════════════════════════════════════════════════════════════════
# Axeng — Setup Verification Script
# ══════════════════════════════════════════════════════════════════
set -e

echo "╔══════════════════════════════════════════════════════════════╗"
echo "║              Axeng Setup Verification                        ║"
echo "╚══════════════════════════════════════════════════════════════╝"
echo ""

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AXENG_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
HERMES_DIR="${HERMES_DIR:-$HOME/.hermes}"

cd "$AXENG_DIR"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

check_pass=0
check_fail=0
check_warn=0

# Function to check and report
check() {
    local name="$1"
    local command="$2"
    local required="$3"

    printf "%-40s " "$name"

    if eval "$command" &> /dev/null; then
        echo -e "${GREEN}✓${NC}"
        ((check_pass++))
        return 0
    else
        if [ "$required" = "required" ]; then
            echo -e "${RED}✗ (required)${NC}"
            ((check_fail++))
        else
            echo -e "${YELLOW}⚠ (optional)${NC}"
            ((check_warn++))
        fi
        return 1
    fi
}

echo "═══ System Dependencies ═══════════════════════════════════════"
check "Python 3.10+" "python3 --version | grep -qE '3\.(1[0-9]|[2-9][0-9])'" required
check "pip3" "command -v pip3" required
check "Docker" "docker --version" required
check "Docker running" "docker ps" required
check "GitHub CLI (gh)" "command -v gh" optional
check "Make" "command -v make" optional

echo ""
echo "═══ Python Dependencies ═══════════════════════════════════════"
check "PyYAML" "python3 -c 'import yaml'" required
check "Streamlit" "python3 -c 'import streamlit'" required
check "Anthropic SDK" "python3 -c 'import anthropic'" optional
check "OpenAI SDK" "python3 -c 'import openai'" optional
check "Google API Client" "python3 -c 'import googleapiclient'" required
check "Google Auth" "python3 -c 'import google.auth'" required

echo ""
echo "═══ Configuration Files ═══════════════════════════════════════"
check ".env file exists" "test -f $AXENG_DIR/.env" required
check "config.yaml exists" "test -f $AXENG_DIR/config/config.yaml" required

if [ -f "$AXENG_DIR/.env" ]; then
    # Check for at least one LLM provider
    if grep -qE '^(ANTHROPIC|OPENAI|OPENCODE|GROQ|OPENROUTER|GOOGLE)_API_KEY=.+' "$AXENG_DIR/.env"; then
        printf "%-40s ${GREEN}✓${NC}\n" "LLM API key configured"
        ((check_pass++))
    else
        printf "%-40s ${RED}✗ (required)${NC}\n" "LLM API key configured"
        ((check_fail++))
    fi

    # Check for GitHub
    if grep -qE '^GITHUB_TOKEN=.+' "$AXENG_DIR/.env" || command -v gh &> /dev/null; then
        printf "%-40s ${GREEN}✓${NC}\n" "GitHub auth configured"
        ((check_pass++))
    else
        printf "%-40s ${RED}✗ (required)${NC}\n" "GitHub auth configured"
        ((check_fail++))
    fi

    # Check for Linear
    if grep -qE '^LINEAR_API_KEY=.+' "$AXENG_DIR/.env"; then
        printf "%-40s ${GREEN}✓${NC}\n" "Linear API key configured"
        ((check_pass++))
    else
        printf "%-40s ${YELLOW}⚠ (recommended)${NC}\n" "Linear API key configured"
        ((check_warn++))
    fi
fi

echo ""
echo "═══ Google Workspace (Optional) ═══════════════════════════════"
check "Hermes directory" "test -d $HERMES_DIR" optional
check "Google API script" "test -f $HERMES_DIR/skills/productivity/google-workspace/scripts/google_api.py" optional
check "Google client secret" "test -f $HERMES_DIR/secrets/google_client_secret.json" optional
check "Google token (authenticated)" "test -f $HERMES_DIR/secrets/google_token.json" optional

echo ""
echo "═══ Directory Structure ═══════════════════════════════════════"
check "src/ directory" "test -d $AXENG_DIR/src" required
check "ui/ directory" "test -d $AXENG_DIR/ui" required
check "config/ directory" "test -d $AXENG_DIR/config" required
check "bin/ directory" "test -d $AXENG_DIR/bin" required

echo ""
echo "═══ Docker ════════════════════════════════════════════════════"
check "docker-compose.yml" "test -f $AXENG_DIR/docker-compose.yml" required
check "Dockerfile" "test -f $AXENG_DIR/docker/Dockerfile" required

echo ""
echo "╔══════════════════════════════════════════════════════════════╗"
echo "║                    Summary                                   ║"
echo "╚══════════════════════════════════════════════════════════════╝"
echo -e "Passed:   ${GREEN}$check_pass${NC}"
echo -e "Failed:   ${RED}$check_fail${NC}"
echo -e "Warnings: ${YELLOW}$check_warn${NC}"
echo ""

if [ $check_fail -eq 0 ]; then
    echo -e "${GREEN}✓ Setup looks good!${NC}"
    echo ""
    echo "Next steps:"
    echo "  1. Review configuration: nano .env"
    echo "  2. Start Axeng: make dev"
    echo "  3. Open: http://localhost:8501"
    echo ""
    if [ $check_warn -gt 0 ]; then
        echo "Optional setup:"
        echo "  - Google Workspace: make setup-google"
        echo "  - Linear API: Add LINEAR_API_KEY to .env"
        echo ""
    fi
    exit 0
else
    echo -e "${RED}✗ Setup incomplete${NC}"
    echo ""
    echo "Required actions:"

    if ! python3 --version | grep -qE '3\.(1[0-9]|[2-9][0-9])' 2>/dev/null; then
        echo "  • Install Python 3.10+: brew install python@3.12"
    fi

    if ! command -v docker &> /dev/null; then
        echo "  • Install Docker: brew install --cask docker"
    fi

    if ! docker ps &> /dev/null 2>&1; then
        echo "  • Start Docker Desktop: open -a Docker"
    fi

    if ! python3 -c 'import yaml' &> /dev/null; then
        echo "  • Install Python deps: make install"
    fi

    if [ ! -f "$AXENG_DIR/.env" ]; then
        echo "  • Create .env: make setup-env"
    fi

    if [ -f "$AXENG_DIR/.env" ]; then
        if ! grep -qE '^(ANTHROPIC|OPENAI|OPENCODE|GROQ|OPENROUTER|GOOGLE)_API_KEY=.+' "$AXENG_DIR/.env"; then
            echo "  • Add LLM API key to .env"
        fi

        if ! grep -qE '^GITHUB_TOKEN=.+' "$AXENG_DIR/.env" && ! command -v gh &> /dev/null; then
            echo "  • Configure GitHub: gh auth login OR add GITHUB_TOKEN to .env"
        fi
    fi

    echo ""
    echo "Run 'make quick-start' to set up everything automatically."
    echo ""
    exit 1
fi
