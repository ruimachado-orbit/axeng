# ═══════════════════════════════════════════════════════════════
# Team Intel — Configuration Template
# Copy this file to config/config.yaml and fill in your values.
# All settings are used by weekly_report.py and project_map.py.
# ═══════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────
# EMAIL
# ───────────────────────────────────────────────────────────────
email:
  # Comma-separated or list of recipient addresses
  recipients:
    - "team@example.com"

  # "From" address shown in the email header
  from: "team@example.com"

  # Path to the google_api.py Gmail helper script
  # The script should support: gmail send --to --subject --body --html
  gmail_script: "~/.axeng/skills/productivity/google-workspace/scripts/google_api.py"


# ───────────────────────────────────────────────────────────────
# VACATIONS (PTO)
# ───────────────────────────────────────────────────────────────
vacations:
  # Linear project ID for the Team Vacations project
  # Create a project in Linear and paste its ID here
  project_id: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"


# ───────────────────────────────────────────────────────────────
# GITHUB
# ───────────────────────────────────────────────────────────────
github:
  # GitHub organizations to scan for repos
  orgs:
    - "MyOrg"

  # Specific repos to always include (org/repo format)
  repos: []

  # Map raw GitHub usernames to display names used in reports
  # Key: GitHub login, Value: friendly display name
  name_map:
    "johndoe": "John Doe"
    "jane_dev": "Jane Developer"
    # Example:
    # "github_user": "Display Name"

  # Usernames to exclude from all reports (ex-members, bots, etc.)
  ex_members:
    - "former_employee"
    - "bot_account"


# ───────────────────────────────────────────────────────────────
# LINEAR
# ───────────────────────────────────────────────────────────────
linear:
  # Linear API key — stored in .env as LINEAR_API_KEY
  # api_key: "lin_xxxx"  # Not needed here; script reads from .env

  # Number of issues per project to fetch for roadmap cards
  issues_per_project: 50

  # Map of Linear project names → their Linear project IDs
  # Get IDs from Linear URL: app.linear.app/<workspace>/project/<slug>/<id>
  project_ids:
    "Project Alpha": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
    "Project Beta":  "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
    # Example:
    # "My Project": "947f286c-ec5d-4087-a510-285df0ebcd71"

  # Map of Linear project names → associated GitHub repos and owner
  # Each entry: "Linear Project Name" → { "repos": ["org/repo", ...], "owner": "Full Name" }
  projects:
    "Project Alpha":
      repos:
        - "MyOrg/frontend"
      owner: "John Doe"

    "Project Beta":
      repos:
        - "MyOrg/backend"
        - "MyOrg/shared-lib"
      owner: "Jane Developer"

    # Full example:
    # "My Project":
    #   repos:
    #     - "org/repo-name"
    #     - "org/another-repo"
    #   owner: "Full Name of Project Owner"


# ───────────────────────────────────────────────────────────────
# REPORTING
# ───────────────────────────────────────────────────────────────
reporting:
  # Day of week that the report runs (0=Monday, 4=Friday)
  # The report covers the previous Sat–Fri week
  weekday: 4

  # Timezone for week boundary calculations
  timezone: "Europe/Lisbon"

  # Output directory for saved HTML reports
  output_dir: "~/.axeng/scripts/team-intel/reports"

  # Include the MVP podium section in the report
  show_mvp: true

  # Include roadmap contribution analysis per project card
  show_roadmap_analysis: true

  # Post weekly updates to Linear projects (idempotent — overwrites previous week's update)
  post_linear_updates: true


# ───────────────────────────────────────────────────────────────
# CHAT ACTION ITEMS — extracts to-dos from a chat-event JSONL
# feed, files them as Linear issues, posts a digest to Telegram.
# Source script: src/chat-action-items.py
# ───────────────────────────────────────────────────────────────
chat_action_items:
  # Set to true to enable the skill
  enabled: false

  source:
    # JSONL of chat events. Default targets the hermes WhatsApp
    # Baileys bridge — each line should at least include:
    #   {chatId, senderId, pushName, fromMe, body, mentionedJids,
    #    quotedParticipant, ts}
    path: "~/.axeng/state/whatsapp-observed.jsonl"
    # Cursor file (tracks file offset between runs)
    cursor_path: "~/.axeng/state/chat-action-cursor.json"
    # Optional HTTP endpoint to resolve chat IDs → friendly names.
    # The hermes bridge exposes this at http://127.0.0.1:3000/groups
    # Response shape: {"groups":[{"id":"...","subject":"..."}]}
    subjects_url: ""

  # Manual chat-id → friendly name overrides (used in prompt and digest)
  chat_subjects: {}
    # "351914878001-1555762600@g.us": "Family Group"

  linear:
    # Linear team key where issues are created (team must already exist)
    team_key: ""
    # When the LLM classifies owner=="me", assign the issue to the
    # API key's viewer. Set to false to leave issues unassigned.
    viewer_self: true

  telegram:
    # Posts the digest to TELEGRAM_CHAT_ID via TELEGRAM_BOT_TOKEN.
    enabled: true

  window:
    # Self-gates so the script can be cron'd frequently without
    # spamming outside business hours. enabled=false always runs.
    enabled: true
    days: ["mon","tue","wed","thu","fri"]
    start: "08:00"
    end: "19:30"
    tz: "Europe/Lisbon"


# ───────────────────────────────────────────────────────────────
# GRANOLA — meeting notes and transcripts
# ───────────────────────────────────────────────────────────────
granola:
  # API key is read from env as GRANOLA_API_KEY, not from config.yaml.
  # Get one in Granola desktop: Settings → Connectors → API keys.
  default_days: 30
  export_dir: "~/.axeng/granola"


# ───────────────────────────────────────────────────────────────
# ORCHESTRATOR TOOLS — optional override
# ───────────────────────────────────────────────────────────────
# If omitted, Axeng uses its built-in default tool registry, including
# github_activity, calendar_insights, Linear tools, team_query, and Granola.
# Uncomment and customize only when you need to override defaults.
# orchestrator:
#   tools:
#     - name: granola_notes
#       script: granola_tool.py
#       args: ["notes", "--days", "30", "--limit", "20"]
#       purpose: "List recent Granola meeting notes"
#     - name: granola_latest
#       script: granola_tool.py
#       args: ["latest", "--days", "30", "--transcript"]
#       purpose: "Fetch the latest Granola note with transcript"
#     - name: granola_folders
#       script: granola_tool.py
#       args: ["folders"]
#       purpose: "List Granola folders"
#     - name: granola_export
#       script: granola_tool.py
#       args: ["export", "--days", "30"]
#       purpose: "Export recent Granola notes and transcripts to Markdown"
