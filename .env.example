# ═══════════════════════════════════════════════════════════════
# Axeng — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored — NEVER commit real API keys.
# ═══════════════════════════════════════════════════════════════

# ── LLM PROVIDER (pick one or more for fallback) ──────────────
# Anthropic (Claude) — RECOMMENDED
ANTHROPIC_API_KEY=

# OpenAI (GPT-4o, o1, etc.)
# OPENAI_API_KEY=

# Google AI (Gemini)
# GOOGLE_API_KEY=

# Groq (free tier, fast inference)
# GROQ_API_KEY=

# OpenRouter (multi-provider aggregation)
# OPENROUTER_API_KEY=

# ── GITHUB ─────────────────────────────────────────────────────
# Option 1: Personal Access Token (from github.com/settings/tokens)
GITHUB_TOKEN=

# Option 2: CLI authentication — run `gh auth login` instead of using a token.
# If GITHUB_TOKEN is empty, the scripts will use `gh` CLI (must be installed).

# ── LINEAR ─────────────────────────────────────────────────────
# Get from: linear.app/settings/api → Create API key
LINEAR_API_KEY=

# ── GOOGLE WORKSPACE (Calendar + Gmail) ────────────────────────
# Path to OAuth client secret JSON (from Google Cloud Console)
# Download from: Google Cloud Console → APIs & Services → Credentials → OAuth client
GOOGLE_CLIENT_SECRET=~/.hermes/google_client_secret.json

# Path to OAuth token (created automatically on first auth)
GOOGLE_TOKEN_PATH=~/.hermes/google_token.json

# ── TELEGRAM (optional — for daily briefing notifications) ─────
# Create a bot: talk to @BotFather on Telegram, get the token
TELEGRAM_BOT_TOKEN=

# Your Telegram chat ID (send a message to your bot, then visit api.telegram.org to find it)
TELEGRAM_CHAT_ID=

# ── NEWS API (optional — world news in daily briefings) ───────
# Get free key from: newsapi.org
NEWS_API_KEY=

# ── STREAMLIT UI ────────────────────────────────────────────────
STREAMLIT_SERVER_PORT=8501

# ── OBSIDIAN VAULT (optional — for 1:1 notes + team sync) ───────
# Path to your Obsidian vault — used for 1:1 meeting notes and team memory sync
OBSIDIAN_VAULT_PATH=~/Documents/Obsidian Vault

# ── CRON SCHEDULE (optional) ───────────────────────────────────
# Override default cron schedules if needed
# CRON_STANDUP="30 7 * * 1-5"        # Mon–Fri 07:30
# CRON_WEEKLY_REPORT="0 17 * * 5"    # Fri 17:00
# CRON_SPRINT_HEALTH="0 16 * * 5"    # Fri 16:00