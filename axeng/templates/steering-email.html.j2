{#
  Steering Report — Email Template · Maio Labs brand
  ─────────────────────────────────────────────────────────────────────────────
  Matches the Maio Labs onboarding document style:
    Background:  #faf9f6  (warm cream)
    Primary:     #1a1a2e  (dark navy)
    Accent:      #7c8cff  (blue-purple)
    Border:      #e8e5df
    Card bg:     #f0eeea
    Font:        Gelasio (serif) → Georgia fallback

  To customise: copy to ~/.axeng/templates/steering-email.html.j2
  Template language: Jinja2. Inline CSS only — Gmail strips <style> blocks.
  ─────────────────────────────────────────────────────────────────────────────
#}

{# ── Design tokens ──────────────────────────────────────────────────────────── #}
{%- set BG          = "#faf9f6" -%}
{%- set NAVY        = "#1a1a2e" -%}
{%- set ACCENT      = "#7c8cff" -%}
{%- set CARD        = "#f0eeea" -%}
{%- set WHITE       = "#ffffff" -%}
{%- set BORDER      = "#e8e5df" -%}
{%- set BORDER_DARK = "#e0ddd6" -%}
{%- set MUTED       = "#888888" -%}
{%- set TEXT        = "#333333" -%}
{%- set DANGER      = "#e05a5a" -%}
{%- set WARNING     = "#d97706" -%}
{%- set SUCCESS     = "#22c55e" -%}
{%- set FONT        = "Gelasio, Georgia, 'Times New Roman', serif" -%}
{%- set FONT_UI     = "-apple-system, 'Helvetica Neue', Arial, sans-serif" -%}
{%- set MAX_W       = "660px" -%}

{# ── Helpers ────────────────────────────────────────────────────────────────── #}
{%- macro status_color(s) -%}
  {%- if s == "off_track" %}{{ DANGER }}
  {%- elif s == "at_risk" %}{{ WARNING }}
  {%- else %}{{ SUCCESS }}
  {%- endif %}
{%- endmacro -%}

{%- macro status_label(s) -%}
  {%- if s == "off_track" %}Off Track
  {%- elif s == "at_risk" %}At Risk
  {%- else %}On Track
  {%- endif %}
{%- endmacro -%}

{%- macro eta_label(r) -%}
  {%- if r == "critical" %}Critical
  {%- elif r == "high" %}High
  {%- elif r == "medium" %}Medium
  {%- else %}Low
  {%- endif %}
{%- endmacro -%}

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Engineering Update — {{ report.week_label }}</title>
</head>

<body style="margin:0;padding:0;background:{{ BG }};font-family:{{ FONT }};color:{{ TEXT }};">
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="background:{{ BG }};padding:40px 0 64px;">
<tr><td align="center">
<table width="{{ MAX_W }}" cellpadding="0" cellspacing="0" border="0" style="max-width:{{ MAX_W }};width:100%;">

{# ══════════════════════════════════════════════════════════
   COVER STRIP — dark navy, matches onboarding cover style
   ══════════════════════════════════════════════════════════ #}
<tr>
  <td style="background:{{ NAVY }};border-radius:8px 8px 0 0;padding:32px 32px 28px;">
    <p style="margin:0 0 16px;font-family:{{ FONT_UI }};font-size:11px;
               letter-spacing:6px;text-transform:uppercase;color:rgba(255,255,255,0.5);">
      Maio Labs
    </p>
    <h1 style="margin:0 0 6px;font-family:{{ FONT }};font-size:26px;font-weight:400;
               color:{{ WHITE }};letter-spacing:-0.02em;line-height:1.2;">
      Engineering Update
    </h1>
    <p style="margin:0;font-family:{{ FONT_UI }};font-size:12px;color:rgba(255,255,255,0.5);">
      {{ report.week_label }}
      &nbsp;·&nbsp;
      For {{ report.recipient_name }}
      &nbsp;·&nbsp;
      {{ report.generated_at[:10] }}
    </p>
  </td>
</tr>

{# ══════════════════════════════════════════════════════════
   BOTTOM LINE — accent left border, matches highlight box style
   ══════════════════════════════════════════════════════════ #}
<tr>
  <td style="padding:0;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td width="4" style="background:{{ ACCENT }};border-radius:0;"></td>
        <td style="background:{{ CARD }};padding:20px 24px;">
          <p style="margin:0 0 4px;font-family:{{ FONT_UI }};font-size:10px;font-weight:600;
                     color:{{ ACCENT }};text-transform:uppercase;letter-spacing:0.1em;">
            Bottom Line
          </p>
          <p style="margin:0;font-family:{{ FONT }};font-size:16px;line-height:1.6;color:{{ NAVY }};">
            {{ report.bottom_line }}
          </p>
        </td>
      </tr>
    </table>
  </td>
</tr>

{# ══════════════════════════════════════════════════════════
   SPRINT PULSE — only when sprint data is available
   ══════════════════════════════════════════════════════════ #}
{% set sp = report.sprint_signals %}
{% if sp and sp.sprint_name %}
<tr>
  <td style="padding:24px 0 0;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0"
           style="border:1px solid {{ BORDER_DARK }};border-radius:6px;background:{{ WHITE }};">
      <tr>
        <td style="padding:12px 20px;border-bottom:1px solid {{ BORDER }};
                    background:{{ NAVY }};border-radius:6px 6px 0 0;">
          <p style="margin:0;font-family:{{ FONT_UI }};font-size:10px;font-weight:600;
                     text-transform:uppercase;letter-spacing:0.1em;color:rgba(255,255,255,0.6);">
            Sprint Pulse &nbsp;·&nbsp; {{ sp.sprint_name }}
            {%- if sp.days_remaining_in_sprint is not none %}
            &nbsp;·&nbsp;
            <span style="color:{{ 'rgba(224,90,90,0.9)' if sp.days_remaining_in_sprint <= 2 else 'rgba(255,255,255,0.8)' }};">
              {{ sp.days_remaining_in_sprint }}d left
            </span>
            {%- endif %}
          </p>
        </td>
      </tr>
      <tr>
        <td style="padding:14px 20px;">
          <table width="100%" cellpadding="0" cellspacing="0" border="0"
                 style="font-family:{{ FONT_UI }};font-size:12px;">
            <tr>
              <td style="width:50%;vertical-align:top;color:{{ TEXT }};">
                <span style="color:{{ MUTED }};text-transform:uppercase;font-size:10px;
                              letter-spacing:0.08em;">Sprint</span><br>
                <strong style="font-size:14px;color:{{ NAVY }};">
                  {{ sp.sprint_completion_rate | int }}% done
                </strong>
                &nbsp;/&nbsp;{{ sp.sprint_time_progress | int }}% elapsed
                &nbsp;
                {%- if sp.sprint_status == "on_track" %}
                  <span style="color:{{ SUCCESS }};">● On track</span>
                {%- elif sp.sprint_status == "at_risk" %}
                  <span style="color:{{ WARNING }};">● At risk</span>
                {%- elif sp.sprint_status == "off_track" %}
                  <span style="color:{{ DANGER }};">● Off track</span>
                {%- endif %}
              </td>
              <td style="width:50%;vertical-align:top;padding-left:20px;
                          border-left:1px solid {{ BORDER }};color:{{ TEXT }};">
                <span style="color:{{ MUTED }};text-transform:uppercase;font-size:10px;
                              letter-spacing:0.08em;">Team Velocity · last {{ sp.cycles_analyzed }} sprints</span><br>
                <strong style="font-size:14px;color:{{ NAVY }};">{{ sp.velocity_avg }} pts/day</strong>
                &nbsp;
                {%- if sp.velocity_trend == "declining" %}
                  <span style="color:{{ DANGER }};font-weight:600;">↓ Declining</span>
                {%- elif sp.velocity_trend == "improving" %}
                  <span style="color:{{ SUCCESS }};font-weight:600;">↑ Improving</span>
                {%- elif sp.velocity_trend == "stable" %}
                  <span style="color:{{ MUTED }};">→ Stable</span>
                {%- else %}
                  <span style="color:{{ MUTED }};">— Insufficient data</span>
                {%- endif %}
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </td>
</tr>
{% endif %}

{# ══════════════════════════════════════════════════════════
   DECISIONS NEEDED
   ══════════════════════════════════════════════════════════ #}
{% if report.decisions %}
<tr>
  <td style="padding:24px 0 0;">
    <p style="margin:0 0 10px;font-family:{{ FONT_UI }};font-size:10px;font-weight:600;
               color:{{ NAVY }};text-transform:uppercase;letter-spacing:0.1em;">
      Decisions Needed This Week
    </p>
    <table width="100%" cellpadding="0" cellspacing="0" border="0"
           style="border:1px solid {{ BORDER_DARK }};border-radius:6px;
                  background:{{ WHITE }};overflow:hidden;">
{% for d in report.decisions %}
      <tr style="border-bottom:{{ '1px solid ' + BORDER if not loop.last else 'none' }};">
        <td style="padding:14px 20px;">
          <table width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td width="12" style="vertical-align:top;padding-top:3px;">
                <span style="display:inline-block;width:8px;height:8px;border-radius:50%;
                              background:{{ status_color(d.status) }};margin-right:10px;"></span>
              </td>
              <td>
                <p style="margin:0 0 2px;font-family:{{ FONT_UI }};font-size:13px;
                           font-weight:600;color:{{ NAVY }};">
                  {{ d.project }}
                  <span style="font-weight:400;color:{{ MUTED }};font-size:11px;margin-left:8px;">
                    {{ d.owner }}
                  </span>
                </p>
                <p style="margin:0;font-family:{{ FONT }};font-size:13px;
                           color:{{ TEXT }};line-height:1.5;">
                  {{ d.text }}
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
{% endfor %}
    </table>
  </td>
</tr>
{% endif %}

{# ══════════════════════════════════════════════════════════
   PORTFOLIO TABLE — one line per project
   ══════════════════════════════════════════════════════════ #}
<tr>
  <td style="padding:24px 0 0;">
    <p style="margin:0 0 10px;font-family:{{ FONT_UI }};font-size:10px;font-weight:600;
               color:{{ NAVY }};text-transform:uppercase;letter-spacing:0.1em;">
      Portfolio — {{ report.projects | length }} Projects
    </p>
    <table width="100%" cellpadding="0" cellspacing="0" border="0"
           style="border:1px solid {{ BORDER_DARK }};border-radius:6px;
                  background:{{ WHITE }};font-family:{{ FONT_UI }};font-size:12px;">
      <tr style="background:{{ NAVY }};">
        <td style="padding:8px 16px;color:rgba(255,255,255,0.6);font-size:10px;
                    text-transform:uppercase;letter-spacing:0.08em;width:28%;">Project</td>
        <td style="padding:8px 12px;color:rgba(255,255,255,0.6);font-size:10px;
                    text-transform:uppercase;letter-spacing:0.08em;width:16%;">Owner</td>
        <td style="padding:8px 12px;color:rgba(255,255,255,0.6);font-size:10px;
                    text-transform:uppercase;letter-spacing:0.08em;width:30%;">Progress</td>
        <td style="padding:8px 12px;color:rgba(255,255,255,0.6);font-size:10px;
                    text-transform:uppercase;letter-spacing:0.08em;width:13%;">Status</td>
        <td style="padding:8px 12px;color:rgba(255,255,255,0.6);font-size:10px;
                    text-transform:uppercase;letter-spacing:0.08em;width:13%;">Target</td>
      </tr>
{% for p in report.projects %}
  {%- set work = p.work_progress_pct | int -%}
  {%- set time = p.time_progress_pct | int -%}
  {%- set col  = status_color(p.status) -%}
      <tr style="border-top:1px solid {{ BORDER }};">
        <td style="padding:10px 16px;font-weight:600;color:{{ NAVY }};font-size:13px;">
          {{ p.name }}
        </td>
        <td style="padding:10px 12px;color:{{ MUTED }};font-size:12px;">{{ p.owner }}</td>
        <td style="padding:10px 12px;">
          {# Progress bar + time cursor #}
          <table width="160" cellpadding="0" cellspacing="0" border="0"
                 style="display:inline-table;border-radius:3px;overflow:hidden;">
            <tr>
              {%- if work > 0 %}
              <td width="{{ [work * 1.6, 160] | min | int }}" height="6"
                  style="background:{{ col }};"></td>
              {%- endif %}
              {%- if work < 100 %}
              <td height="6" style="background:{{ BORDER_DARK }};"></td>
              {%- endif %}
            </tr>
          </table>
          {# Time cursor line #}
          <table width="160" cellpadding="0" cellspacing="0" border="0"
                 style="display:inline-table;margin-top:1px;">
            <tr>
              <td width="{{ [time * 1.6, 158] | min | int }}" height="2"
                  style="background:transparent;"></td>
              <td width="2" height="2" style="background:{{ MUTED }};"></td>
              <td height="2" style="background:transparent;"></td>
            </tr>
          </table>
          <span style="font-size:10px;color:{{ MUTED }};margin-left:6px;">{{ work }}%</span>
        </td>
        <td style="padding:10px 12px;">
          <span style="display:inline-block;padding:2px 8px;border-radius:3px;
                        font-size:10px;font-weight:600;letter-spacing:0.04em;
                        color:{{ WHITE }};background:{{ col }};">
            {{ status_label(p.status) }}
          </span>
        </td>
        <td style="padding:10px 12px;font-size:11px;color:{{ MUTED }};white-space:nowrap;">
          {% if p.target_date %}{{ p.target_date }}
            {% if p.days_left is not none %}
            <br><span style="color:{{ DANGER if p.days_left < 14 else MUTED }};">{{ p.days_left }}d</span>
            {% endif %}
          {% else %}—{% endif %}
        </td>
      </tr>
{% endfor %}
    </table>
  </td>
</tr>

{# ══════════════════════════════════════════════════════════
   PROJECT CARDS
   ══════════════════════════════════════════════════════════ #}
<tr>
  <td style="padding:24px 0 0;">
    <p style="margin:0 0 10px;font-family:{{ FONT_UI }};font-size:10px;font-weight:600;
               color:{{ NAVY }};text-transform:uppercase;letter-spacing:0.1em;">
      Project Detail
    </p>
  </td>
</tr>

{% for p in report.projects %}
{%- set col = status_color(p.status) -%}
<tr>
  <td style="padding:0 0 10px;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0"
           style="border:1px solid {{ BORDER_DARK }};border-radius:6px;
                  background:{{ WHITE }};overflow:hidden;">

      {# Card header — navy with colour-coded left bar #}
      <tr>
        <td width="4" style="background:{{ col }};"></td>
        <td style="padding:12px 16px;background:{{ NAVY }};">
          <table width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td>
                <span style="font-family:{{ FONT }};font-size:15px;font-weight:600;
                              color:{{ WHITE }};">{{ p.name }}</span>
                <span style="font-family:{{ FONT_UI }};font-size:11px;
                              color:rgba(255,255,255,0.5);margin-left:10px;">{{ p.owner }}</span>
              </td>
              <td align="right">
                <span style="font-family:{{ FONT_UI }};font-size:10px;font-weight:600;
                              letter-spacing:0.06em;color:{{ col }};">
                  {{ status_label(p.status).upper() }}
                </span>
                <span style="font-family:{{ FONT_UI }};font-size:10px;
                              color:rgba(255,255,255,0.4);margin-left:8px;">
                  {{ p.health_score | int }}/100
                </span>
              </td>
            </tr>
          </table>
        </td>
      </tr>

      {# Timeline row #}
      <tr>
        <td width="4" style="background:{{ BORDER }};"></td>
        <td style="padding:10px 16px;border-bottom:1px solid {{ BORDER }};background:{{ CARD }};">
          <table width="100%" cellpadding="0" cellspacing="0" border="0"
                 style="font-family:{{ FONT_UI }};font-size:11px;color:{{ MUTED }};">
            <tr>
              <td>
                <strong style="color:{{ NAVY }};">{{ p.work_progress_pct | int }}%</strong> done
                &nbsp;/&nbsp;{{ p.time_progress_pct | int }}% elapsed
                &nbsp;·&nbsp;
                ETA:
                <span style="color:{{ DANGER if p.eta_risk in ('critical','high') else (WARNING if p.eta_risk == 'medium' else SUCCESS) }};
                              font-weight:600;">{{ eta_label(p.eta_risk) }}</span>
                {%- if report.sprint_signals and report.sprint_signals.velocity_trend == "declining" %}
                &nbsp;·&nbsp;<span style="color:{{ DANGER }};">↓ team vel</span>
                {%- elif report.sprint_signals and report.sprint_signals.velocity_trend == "improving" %}
                &nbsp;·&nbsp;<span style="color:{{ SUCCESS }};">↑ team vel</span>
                {%- endif %}
              </td>
              <td align="right">
                {% if p.target_date %}
                  <strong style="color:{{ NAVY }};">{{ p.target_date }}</strong>
                  {% if p.days_left is not none %}
                  &nbsp;({{ p.days_left }}d left)
                  {% endif %}
                {% else %}
                  No target date
                {% endif %}
              </td>
            </tr>
          </table>
        </td>
      </tr>

      {# Blockers #}
{% if p.blockers %}
      <tr>
        <td width="4" style="background:{{ BORDER }};"></td>
        <td style="padding:10px 16px;border-bottom:1px solid {{ BORDER }};">
          <p style="margin:0 0 5px;font-family:{{ FONT_UI }};font-size:10px;font-weight:600;
                     color:{{ MUTED }};text-transform:uppercase;letter-spacing:0.08em;">
            Blockers
          </p>
{% for b in p.blockers[:3] %}
          <p style="margin:0 0 3px;font-family:{{ FONT }};font-size:13px;
                     color:{{ TEXT }};line-height:1.4;">
            &bull; {{ b }}
          </p>
{% endfor %}
        </td>
      </tr>
{% endif %}

      {# Meeting signal #}
{% if p.meeting_signal %}
      <tr>
        <td width="4" style="background:{{ ACCENT }};"></td>
        <td style="padding:10px 16px;border-bottom:1px solid {{ BORDER }};background:#f5f4ff;">
          <p style="margin:0 0 4px;font-family:{{ FONT_UI }};font-size:10px;font-weight:600;
                     color:{{ ACCENT }};text-transform:uppercase;letter-spacing:0.08em;">
            From Meetings
          </p>
          <p style="margin:0;font-family:{{ FONT }};font-size:13px;
                     color:{{ TEXT }};font-style:italic;line-height:1.4;">
            {{ p.meeting_signal }}
          </p>
        </td>
      </tr>
{% endif %}

      {# This week #}
{% if p.week_delta %}
      <tr>
        <td width="4" style="background:{{ BORDER }};"></td>
        <td style="padding:10px 16px;border-bottom:{% if p.decision_needed %}1px solid {{ BORDER }}{% else %}none{% endif %};">
          <p style="margin:0 0 4px;font-family:{{ FONT_UI }};font-size:10px;font-weight:600;
                     color:{{ MUTED }};text-transform:uppercase;letter-spacing:0.08em;">
            This Week
          </p>
          <p style="margin:0;font-family:{{ FONT }};font-size:13px;
                     color:{{ TEXT }};line-height:1.4;">
            {{ p.week_delta }}
          </p>
        </td>
      </tr>
{% endif %}

      {# Decision needed — accent highlight #}
{% if p.decision_needed %}
      <tr>
        <td width="4" style="background:{{ ACCENT }};"></td>
        <td style="padding:10px 16px;background:#f5f4ff;">
          <p style="margin:0 0 4px;font-family:{{ FONT_UI }};font-size:10px;font-weight:600;
                     color:{{ ACCENT }};text-transform:uppercase;letter-spacing:0.08em;">
            Action Needed
          </p>
          <p style="margin:0;font-family:{{ FONT }};font-size:13px;
                     font-weight:600;color:{{ NAVY }};line-height:1.4;">
            {{ p.decision_needed }}
          </p>
        </td>
      </tr>
{% endif %}

    </table>
  </td>
</tr>
{% endfor %}

{# ══════════════════════════════════════════════════════════
   CROSS-PROJECT SIGNALS
   ══════════════════════════════════════════════════════════ #}
{% if report.cross_project_risks %}
<tr>
  <td style="padding:8px 0 0;">
    <p style="margin:0 0 10px;font-family:{{ FONT_UI }};font-size:10px;font-weight:600;
               color:{{ NAVY }};text-transform:uppercase;letter-spacing:0.1em;">
      Cross-Project Signals
    </p>
    <table width="100%" cellpadding="14" cellspacing="0" border="0"
           style="border:1px solid {{ BORDER_DARK }};border-radius:6px;background:{{ WHITE }};">
      <tr>
        <td>
{% for r in report.cross_project_risks %}
          <p style="margin:0 0 5px;font-family:{{ FONT }};font-size:13px;
                     color:{{ TEXT }};line-height:1.5;">&bull; {{ r }}</p>
{% endfor %}
        </td>
      </tr>
    </table>
  </td>
</tr>
{% endif %}

{# ══════════════════════════════════════════════════════════
   CAPACITY
   ══════════════════════════════════════════════════════════ #}
{% if report.ooo %}
<tr>
  <td style="padding:16px 0 0;">
    <p style="margin:0 0 10px;font-family:{{ FONT_UI }};font-size:10px;font-weight:600;
               color:{{ NAVY }};text-transform:uppercase;letter-spacing:0.1em;">
      Team Capacity
    </p>
    <table width="100%" cellpadding="12" cellspacing="0" border="0"
           style="border:1px solid {{ BORDER_DARK }};border-radius:6px;background:{{ WHITE }};">
      <tr>
        <td style="font-family:{{ FONT_UI }};font-size:13px;color:{{ TEXT }};">
          Out of office: <strong style="color:{{ NAVY }};">{{ report.ooo | join(", ") }}</strong>
        </td>
      </tr>
    </table>
  </td>
</tr>
{% endif %}

{# ══════════════════════════════════════════════════════════
   MANUAL CONTEXT BLOCK — uncomment to add a note
   ══════════════════════════════════════════════════════════ #}
{#
<tr>
  <td style="padding:16px 0 0;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td width="4" style="background:{{ ACCENT }};border-radius:4px 0 0 4px;"></td>
        <td style="background:#f5f4ff;padding:16px 20px;border-radius:0 4px 4px 0;">
          <p style="margin:0 0 6px;font-family:{{ FONT_UI }};font-size:10px;font-weight:600;
                     color:{{ ACCENT }};text-transform:uppercase;letter-spacing:0.1em;">
            Additional Context
          </p>
          <p style="margin:0;font-family:{{ FONT }};font-size:14px;color:{{ NAVY }};line-height:1.6;">
            Edit this block in ~/.axeng/templates/steering-email.html.j2
          </p>
        </td>
      </tr>
    </table>
  </td>
</tr>
#}

{# ══════════════════════════════════════════════════════════
   FOOTER — matches onboarding footer style
   ══════════════════════════════════════════════════════════ #}
<tr>
  <td style="padding:32px 0 0;border-top:1px solid {{ BORDER }};margin-top:24px;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td>
          <p style="margin:0;font-family:{{ FONT_UI }};font-size:11px;color:{{ MUTED }};
                     letter-spacing:0.04em;">
