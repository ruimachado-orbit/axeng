# ═══════════════════════════════════════════════════════════════
# Axeng — .gitignore
# ═══════════════════════════════════════════════════════════════

# Environment variables — NEVER commit these
.env
.env.local
.env.*.local
*.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
.venv/
ENV/
.ENV

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Reports (generated output)
reports/*.html
ui/nextjs/out-website/
ui/nextjs/.deploy/

# Website (marketing site)
website/node_modules/
website/.next/
website/out/
website/out-website/
website/.deploy/

# Obsidian vault (local data)
vault/
*.md.archived

# Credentials (but allow package.json and tsconfig.json)
*.json
!config/*.example.json
!package.json
!tsconfig.json
!package-lock.json
credentials/

# Docker
.docker/

# Logs
*.log
logs/

# Local config overrides
config/config.yaml
!config/config.yaml.example

# Secrets (generic)
secrets/
*.secret

# Hermes directory (local user data)
.hermes/

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/
