# ═══════════════════════════════════════════════════════════════
# Axeng — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored — NEVER commit real API keys.
# ═══════════════════════════════════════════════════════════════

# ── LLM PROVIDERS ─────────────────────────────────────────────────────────────
# Axeng supports 8 providers with automatic fallback.
# Uncomment and fill only the providers you want to use.
#
#  PROVIDER    │  BEST FOR            │  API KEY VAR          │  LOCAL?
#  ────────────┼──────────────────────┼───────────────────────┼──────────
#  Anthropic   │  Reasoning + speed   │  ANTHROPIC_API_KEY    │  Cloud
#  OpenAI      │  o1/o3 reasoning     │  OPENAI_API_KEY       │  Cloud
#  OpenCode    │  Coding specialist   │  OPENCODE_API_KEY     │  Cloud
#  Groq        │  Fast free inference  │  GROQ_API_KEY        │  Cloud
#  OpenRouter  │  Multi-provider agg  │  OPENROUTER_API_KEY   │  Cloud
#  Google AI   │  Gemini 2.0 Flash    │  GOOGLE_API_KEY       │  Cloud
#  Ollama      │  Local llama3/mixtral │  (no key needed)     │  Local
#  LM Studio   │  Local GGUF models    │  (no key needed)     │  Local

# Cloud providers — add your API keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENCODE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=

# ── LOCAL LLM PROVIDERS ───────────────────────────────────────────────────────
# No API key needed — Axeng auto-detects if the server is running.

# Ollama — run: `ollama serve`
# Ollama serves at localhost:11434 by default — no key needed.
# Override URL only if you run on a different port/host.
OLLAMA_BASE_URL=http://localhost:11434/v1

# LM Studio — run the desktop app, default port 1234
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# ── Model Overrides (optional) ───────────────────────────────────────────────
# Defaults if not set:
#   anthropic  → claude-sonnet-4-7
#   openai     → gpt-4o
#   opencode   → opencode-o3-mini
#   groq       → llama-3.3-70b-versatile
#   openrouter → anthropic/claude-3.5-sonnet
#   google     → gemini-2.0-flash
#   ollama     → llama3.3 (override with OLLAMA_MODEL)
#   lmstudio   → auto-detected from server

# ANTHROPIC_MODEL=claude-sonnet-4-7
# OPENAI_MODEL=gpt-4o
# OLLAMA_MODEL=llama3.3
# LMSTUDIO_MODEL=llama3.3

# ── LLM Fallback Order ───────────────────────────────────────────────────────
# Axeng tries providers left-to-right until one succeeds.
# Uncomment to override the default order.
# LLM_PROVIDER_ORDER=anthropic,openai,opencode,groq,openrouter,google,ollama,lmstudio

# ── LLM Global Settings ───────────────────────────────────────────────────────
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# ── GITHUB ──────────────────────────────────────────────────────────────────
# Option A: Personal Access Token
GITHUB_TOKEN=

# Option B: CLI — run `gh auth login` instead. No token needed here.
# If GITHUB_TOKEN is empty, scripts use `gh` CLI (must be installed).

# ── LINEAR ──────────────────────────────────────────────────────────────────
# Get from: linear.app/settings/api → Create API key
LINEAR_API_KEY=

# ── GOOGLE WORKSPACE (Calendar + Gmail) ────────────────────────────────────
# Download OAuth client JSON from: Google Cloud Console → Credentials
GOOGLE_CLIENT_SECRET=~/.hermes/secrets/google_client_secret.json
GOOGLE_TOKEN_PATH=~/.hermes/secrets/google_token.json

# ── TELEGRAM (optional — daily briefing notifications) ─────────────────────
# Create a bot: talk to @BotFather → get the bot token
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── NEWS API (optional — world news in daily briefings) ───────────────────
# Free key at: newsapi.org
NEWS_API_KEY=

# ── STREAMLIT UI ────────────────────────────────────────────────────────────
STREAMLIT_SERVER_PORT=8501

# ── OBSIDIAN VAULT (optional — 1:1 notes + team memory) ───────────────────
OBSIDIAN_VAULT_PATH=~/Documents/Obsidian Vault

# ── CRON SCHEDULE (optional) ───────────────────────────────────────────────
# CRON_STANDUP="30 7 * * 1-5"        # Mon–Fri 07:30
# CRON_WEEKLY_REPORT="0 17 * * 5"    # Fri 17:00
# CRON_SPRINT_HEALTH="0 16 * * 5"    # Fri 16:00