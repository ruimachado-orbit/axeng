{# ════════════════════════════════════════════════════════════════════════════
   FOOTER
   ════════════════════════════════════════════════════════════════════════════ #}
        <tr>
          <td style="padding:24px 0 0;border-top:1px solid {{ BORDER_COLOR }};">
            <p style="margin:0;font-size:11px;color:{{ MUTED_COLOR }};
                      line-height:1.6;text-align:center;
                      font-family:Arial,Helvetica,sans-serif;">
              Generated by Axeng &middot; {{ report.generated_at[:16] | replace("T", " ") }}
              &middot; Signals: {{ report.sources | join(", ") }}
              {% if report.errors %}
              <br><span style="color:{{ WARNING_COLOR }};">
                Partial data: {{ report.errors | join("; ") }}
              </span>
              {% endif %}
            </p>
          </td>
        </tr>

      </table>
    </td>
  </tr>
</table>

</body>
</html>
